# SENTINEL-X Environment Configuration

# Server Port
PORT=3001

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database URL
# For local SQLite: file:./dev.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/sentinel_x?schema=public
DATABASE_URL="file:./dev.db"

# JWT Secret for Operator Sessions
JWT_SECRET=sentinel-x-ultra-secure-clearance-jwt-key-2026-alpha-7

# System Operational Mode
NODE_ENV=development
LOG_LEVEL=info

# Computer Vision & Tracking Engine Thresholds
DETECTION_CONFIDENCE_THRESHOLD=0.35
OCCLUSION_TIMEOUT_MS=3000
PREDICTION_TIMEOUT_MS=5000
ANOMALY_THRESHOLD=2.8
